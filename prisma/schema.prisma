generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScholarshipStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ApplicationSupportType {
  SELF_FUNDED
  SCHOLARSHIP
  SPECIALIZED_MENTORSHIP
  PROMO
}

enum LearningMode {
  ONLINE
  ONSITE
  HYBRID
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum CohortStatus {
  PLANNED
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TeacherCohortApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LessonKind {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
  LIVE
}

enum LessonContentKind {
  TEXT
  VIDEO
  ATTACHMENT
}

enum ModuleAccessType {
  FREE_BOOTCAMP
  PAID
  PROMO
  ALL_ENROLLED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

model UserProfile {
  id        String   @id @db.Uuid
  email     String?  @unique
  firstName String   @default("") @map("first_name")
  lastName  String   @default("") @map("last_name")
  phone     String?
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  applications               ScholarshipApplication[]   @relation("Applicant")
  enrollments                Enrollment[]
  teachingAssignments        CohortTeachingAssignment[]
  teachingSessions           LiveSession[]
  courseSuggestions          CourseSuggestion[]         @relation("CourseSuggestionSubmitter")
  reviewedSuggestions        CourseSuggestion[]         @relation("CourseSuggestionReviewer")
  cohortApplications         TeacherCohortApplication[] @relation("CohortApplicationTeacher")
  reviewedCohortApplications TeacherCohortApplication[] @relation("CohortApplicationReviewer")
  validatedAttendance        AttendanceRecord[]         @relation("AttendanceValidator")
  courseActionLogs           TeacherCourseActionLog[]
  createdCampaigns           PromoCampaign[]            @relation("CampaignCreator")
  promoRedemptions           PromoRedemption[]

  @@map("user_profiles")
}

model Course {
  id                  String       @id @default(uuid()) @db.Uuid
  slug                String       @unique
  title               String
  category            String
  description         String       @db.Text
  imageUrl            String?      @map("image_url")
  durationWeeks       Int          @map("duration_weeks")
  freeBootcampEnabled Boolean      @default(false) @map("free_bootcamp_enabled")
  status              CourseStatus @default(DRAFT)
  publishedAt         DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  applications      ScholarshipApplication[]
  cohorts           Cohort[]
  modules           CourseModule[]
  enrollments       Enrollment[]
  campaigns         PromoCampaign[]
  suggestions       CourseSuggestion[]
  teacherActionLogs TeacherCourseActionLog[]

  @@index([status, category])
  @@map("courses")
}

model CourseSuggestion {
  id            String                 @id @default(uuid()) @db.Uuid
  title         String
  category      String
  description   String                 @db.Text
  durationWeeks Int                    @map("duration_weeks")
  status        CourseSuggestionStatus @default(PENDING)
  suggestedById String                 @map("suggested_by_id") @db.Uuid
  suggestedBy   UserProfile            @relation("CourseSuggestionSubmitter", fields: [suggestedById], references: [id], onDelete: Cascade)
  reviewedById  String?                @map("reviewed_by_id") @db.Uuid
  reviewedBy    UserProfile?           @relation("CourseSuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  courseId      String?                @unique @map("course_id") @db.Uuid
  course        Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([suggestedById, createdAt])
  @@map("course_suggestions")
}

model Scholarship {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @unique
  sponsor        String?
  description    String?           @db.Text
  tuitionPercent Int?              @map("tuition_percent")
  amount         Decimal?          @db.Decimal(12, 2)
  currency       String            @default("NGN")
  status         ScholarshipStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  applications ScholarshipApplication[]

  @@map("scholarships")
}

model ApplicationConfig {
  id                  Int      @id @default(1)
  scholarshipsEnabled Boolean  @default(true) @map("scholarships_enabled")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("application_config")
}

model OnboardingFieldSetting {
  fieldKey  String   @id @map("field_key")
  audiences String[] @default([])
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("onboarding_field_settings")
}

model ScholarshipApplication {
  id                       String                 @id @default(uuid()) @db.Uuid
  applicantId              String?                @map("applicant_id") @db.Uuid
  applicant                UserProfile?           @relation("Applicant", fields: [applicantId], references: [id], onDelete: SetNull)
  firstName                String                 @map("first_name")
  lastName                 String                 @map("last_name")
  email                    String
  phone                    String
  gender                   String
  country                  String
  otherCountry             String?                @map("other_country")
  location                 String
  employmentStatus         String                 @map("employment_status")
  educationLevel           String                 @map("education_level")
  scholarshipInterest      Boolean                @map("scholarship_interest")
  supportType              ApplicationSupportType @default(SELF_FUNDED) @map("support_type")
  specializedFocus         String?                @map("specialized_focus") @db.Text
  specializedGoal          String?                @map("specialized_goal") @db.Text
  mentorSupport            String?                @map("mentor_support") @db.Text
  promoCode                String?                @map("promo_code")
  promoCampaignId          String?                @map("promo_campaign_id") @db.Uuid
  promoCampaign            PromoCampaign?         @relation(fields: [promoCampaignId], references: [id], onDelete: SetNull)
  completionRequiredFields String[]               @default([]) @map("completion_required_fields")
  scholarshipId            String?                @map("scholarship_id") @db.Uuid
  scholarship              Scholarship?           @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)
  scholarshipName          String?                @map("scholarship_name")
  scholarshipPercent       Int?                   @map("scholarship_percent")
  scholarshipAmount        Decimal?               @map("scholarship_amount") @db.Decimal(12, 2)
  scholarshipCurrency      String?                @map("scholarship_currency")
  cohortId                 String?                @map("cohort_id") @db.Uuid
  cohort                   Cohort?                @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  courseId                 String?                @map("course_id") @db.Uuid
  course                   Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseName               String                 @map("course_name")
  learningMode             LearningMode           @map("learning_mode")
  preferredStartDate       DateTime?              @map("preferred_start_date") @db.Date
  techExperience           String                 @map("tech_experience")
  jobPlacementSupport      Boolean                @map("job_placement_support")
  termsAcceptedAt          DateTime               @map("terms_accepted_at") @db.Timestamptz(6)
  status                   ApplicationStatus      @default(SUBMITTED)
  submittedAt              DateTime               @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment?

  @@index([status, submittedAt])
  @@index([email])
  @@map("scholarship_applications")
}

model Cohort {
  id               String       @id @default(uuid()) @db.Uuid
  courseId         String       @map("course_id") @db.Uuid
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name             String
  seatLimit        Int?         @map("seat_limit")
  startsAt         DateTime     @map("starts_at") @db.Timestamptz(6)
  durationWeeks    Int          @default(12) @map("duration_weeks")
  endsAt           DateTime?    @map("ends_at") @db.Timestamptz(6)
  status           CohortStatus @default(PLANNED)
  learningMode     LearningMode @default(ONLINE) @map("learning_mode")
  whatsappGroupUrl String?      @map("whatsapp_group_url")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollments         Enrollment[]
  teachers            CohortTeachingAssignment[]
  sessions            LiveSession[]
  applications        ScholarshipApplication[]
  teacherApplications TeacherCohortApplication[]

  @@unique([courseId, name])
  @@index([status, startsAt])
  @@map("cohorts")
}

model CohortTeachingAssignment {
  cohortId   String      @map("cohort_id") @db.Uuid
  teacherId  String      @map("teacher_id") @db.Uuid
  assignedAt DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(6)
  cohort     Cohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  teacher    UserProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([cohortId, teacherId])
  @@index([teacherId])
  @@map("cohort_teaching_assignments")
}

model TeacherCohortApplication {
  id           String                         @id @default(uuid()) @db.Uuid
  cohortId     String                         @map("cohort_id") @db.Uuid
  cohort       Cohort                         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  teacherId    String                         @map("teacher_id") @db.Uuid
  teacher      UserProfile                    @relation("CohortApplicationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  status       TeacherCohortApplicationStatus @default(PENDING)
  appliedAt    DateTime                       @default(now()) @map("applied_at") @db.Timestamptz(6)
  reviewedById String?                        @map("reviewed_by_id") @db.Uuid
  reviewedBy   UserProfile?                   @relation("CohortApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?                      @map("reviewed_at") @db.Timestamptz(6)

  @@unique([cohortId, teacherId])
  @@index([status, appliedAt])
  @@index([teacherId, appliedAt])
  @@map("teacher_cohort_applications")
}

model Enrollment {
  id            String                  @id @default(uuid()) @db.Uuid
  learnerId     String                  @map("learner_id") @db.Uuid
  learner       UserProfile             @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  courseId      String                  @map("course_id") @db.Uuid
  course        Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  cohortId      String?                 @map("cohort_id") @db.Uuid
  cohort        Cohort?                 @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  applicationId String?                 @unique @map("application_id") @db.Uuid
  application   ScholarshipApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  status        EnrollmentStatus        @default(PENDING)
  enrolledAt    DateTime                @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt   DateTime?               @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessonProgress LessonProgress[]
  attendance     AttendanceRecord[]

  @@index([learnerId, status])
  @@index([cohortId, status])
  @@map("enrollments")
}

model CourseModule {
  id          String             @id @default(uuid()) @db.Uuid
  courseId    String             @map("course_id") @db.Uuid
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?            @db.Text
  sortOrder   Int                @map("sort_order")
  accessTypes ModuleAccessType[] @default([]) @map("access_types")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessons    Lesson[]
  sessions   LiveSession[]
  actionLogs TeacherCourseActionLog[]

  @@unique([courseId, sortOrder])
  @@map("course_modules")
}

model Lesson {
  id              String       @id @default(uuid()) @db.Uuid
  moduleId        String       @map("module_id") @db.Uuid
  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String?      @db.Text
  kind            LessonKind   @default(ARTICLE)
  contentUrl      String?      @map("content_url")
  durationMinutes Int?         @map("duration_minutes")
  sortOrder       Int          @map("sort_order")
  isPublished     Boolean      @default(false) @map("is_published")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  progress     LessonProgress[]
  contentItems LessonContentItem[]

  @@unique([moduleId, sortOrder])
  @@map("lessons")
}

model LessonContentItem {
  id          String            @id @default(uuid()) @db.Uuid
  lessonId    String            @map("lesson_id") @db.Uuid
  lesson      Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind        LessonContentKind
  title       String?
  body        String?           @db.Text
  url         String?
  fileName    String?           @map("file_name")
  storagePath String?           @map("storage_path")
  sortOrder   Int               @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([lessonId, sortOrder])
  @@map("lesson_content_items")
}

model LessonProgress {
  id             String               @id @default(uuid()) @db.Uuid
  enrollmentId   String               @map("enrollment_id") @db.Uuid
  enrollment     Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId       String               @map("lesson_id") @db.Uuid
  lesson         Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status         LessonProgressStatus @default(NOT_STARTED)
  startedAt      DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?            @map("completed_at") @db.Timestamptz(6)
  lastAccessedAt DateTime?            @map("last_accessed_at") @db.Timestamptz(6)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId, status])
  @@map("lesson_progress")
}

model LiveSession {
  id          String             @id @default(uuid()) @db.Uuid
  cohortId    String             @map("cohort_id") @db.Uuid
  cohort      Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  moduleId    String?            @map("module_id") @db.Uuid
  module      CourseModule?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  teacherId   String?            @map("teacher_id") @db.Uuid
  teacher     UserProfile?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  title       String
  description String?            @db.Text
  startsAt    DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime           @map("ends_at") @db.Timestamptz(6)
  location    String?
  meetingUrl  String?            @map("meeting_url")
  status      SessionStatus      @default(SCHEDULED)
  attendance  AttendanceRecord[]
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([cohortId, startsAt])
  @@index([teacherId, startsAt])
  @@map("live_sessions")
}

model AttendanceRecord {
  id            String           @id @default(uuid()) @db.Uuid
  sessionId     String           @map("session_id") @db.Uuid
  session       LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId  String           @map("enrollment_id") @db.Uuid
  enrollment    Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status        AttendanceStatus @default(PENDING)
  markedAt      DateTime         @default(now()) @map("marked_at") @db.Timestamptz(6)
  validatedAt   DateTime?        @map("validated_at") @db.Timestamptz(6)
  validatedById String?          @map("validated_by_id") @db.Uuid
  validatedBy   UserProfile?     @relation("AttendanceValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sessionId, enrollmentId])
  @@index([sessionId, status])
  @@index([enrollmentId, markedAt])
  @@map("attendance_records")
}

model TeacherCourseActionLog {
  id         String        @id @default(uuid()) @db.Uuid
  teacherId  String        @map("teacher_id") @db.Uuid
  teacher    UserProfile   @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  courseId   String        @map("course_id") @db.Uuid
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId   String?       @map("module_id") @db.Uuid
  module     CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  action     String
  entityType String        @map("entity_type")
  entityId   String?       @map("entity_id")
  details    Json?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([courseId, createdAt])
  @@index([moduleId, createdAt])
  @@index([teacherId, createdAt])
  @@map("teacher_course_action_logs")
}

model PromoCampaign {
  id              String         @id @default(uuid()) @db.Uuid
  createdById     String         @map("created_by_id") @db.Uuid
  createdBy       UserProfile    @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  courseId        String?        @map("course_id") @db.Uuid
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  name            String
  code            String         @unique
  discountPercent Int            @map("discount_percent")
  startsAt        DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime       @map("ends_at") @db.Timestamptz(6)
  redemptionLimit Int?           @map("redemption_limit")
  status          CampaignStatus @default(DRAFT)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  redemptions  PromoRedemption[]
  applications ScholarshipApplication[]

  @@index([status, startsAt, endsAt])
  @@map("promo_campaigns")
}

model PromoRedemption {
  id         String        @id @default(uuid()) @db.Uuid
  campaignId String        @map("campaign_id") @db.Uuid
  campaign   PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  learnerId  String?       @map("learner_id") @db.Uuid
  learner    UserProfile?  @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  email      String?
  redeemedAt DateTime      @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  @@unique([campaignId, learnerId])
  @@index([campaignId, redeemedAt])
  @@map("promo_redemptions")
}

enum DigitalServiceQuoteStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum DigitalServiceFinanceType {
  REVENUE
  EXPENSE
}

enum DigitalServicePaymentMethod {
  CASH
  TRANSFER
  BOTH
}

model DigitalServiceCategory {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  services  DigitalServiceService[]

  @@unique([name])
  @@map("digital_service_categories")
}

model DigitalServiceService {
  id         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String                    @map("category_id") @db.Uuid
  category   DigitalServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name       String
  unit       String                    @default("unit")
  price      Decimal                   @db.Decimal(14, 2)
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  quoteItems DigitalServiceQuoteItem[]

  @@unique([categoryId, name])
  @@map("digital_services")
}

model DigitalServiceCustomer {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  phone          String
  couponCode     String?               @map("coupon_code")
  shareTokenHash String?               @unique @map("share_token_hash")
  shareTokenEncrypted String?          @map("share_token_encrypted")
  serviceCount   Int                   @default(0) @map("service_count")
  serviceAmount  Decimal               @default(0) @map("service_amount") @db.Decimal(14, 2)
  creditBalance  Decimal               @default(0) @map("credit_balance") @db.Decimal(14, 2)
  creditScore    Int                   @default(0) @map("credit_score")
  redeemedAmount Decimal               @default(0) @map("redeemed_amount") @db.Decimal(14, 2)
  referralCredit Decimal               @default(0) @map("referral_credit") @db.Decimal(14, 2)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  quotes         DigitalServiceQuote[]

  @@unique([phone])
  @@unique([couponCode])
  @@map("digital_service_customers")
}

model DigitalServiceAffiliate {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  phone                 String?
  email                 String?
  tier                  String                 @default("Custom")
  notes                 String?
  active                Boolean                @default(true)
  discountPct           Decimal                @default(0) @map("discount_pct") @db.Decimal(5, 2)
  commissionPct         Decimal                @default(0) @map("commission_pct") @db.Decimal(5, 2)
  commissionScore       Decimal                @default(0) @map("commission_score") @db.Decimal(14, 2)
  customerDiscountTotal Decimal                @default(0) @map("customer_discount_total") @db.Decimal(14, 2)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  coupons               DigitalServiceCoupon[]

  @@map("digital_service_affiliates")
}

model DigitalServiceCoupon {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                   @unique
  tier                String                   @default("Custom")
  customerPct         Decimal                  @default(0) @map("customer_pct") @db.Decimal(5, 2)
  customerDirect      Decimal                  @default(0) @map("customer_direct") @db.Decimal(14, 2)
  affiliatePct        Decimal                  @default(0) @map("affiliate_pct") @db.Decimal(5, 2)
  affiliateId         String?                  @map("affiliate_id") @db.Uuid
  affiliate           DigitalServiceAffiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  referralOnly        Boolean                  @default(false) @map("referral_only")
  redemptionThreshold Int                      @default(3) @map("redemption_threshold")
  usageCount          Int                      @default(0) @map("usage_count")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  quotes              DigitalServiceQuote[]

  @@map("digital_service_coupons")
}

model DigitalServiceQuote {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String?                   @map("customer_id") @db.Uuid
  customer         DigitalServiceCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  couponId         String?                   @map("coupon_id") @db.Uuid
  coupon           DigitalServiceCoupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  grossTotal       Decimal                   @default(0) @map("gross_total") @db.Decimal(14, 2)
  directDiscount   Decimal                   @default(0) @map("direct_discount") @db.Decimal(14, 2)
  couponDiscount   Decimal                   @default(0) @map("coupon_discount") @db.Decimal(14, 2)
  payableTotal     Decimal                   @default(0) @map("payable_total") @db.Decimal(14, 2)
  directCost       Decimal                   @default(0) @map("direct_cost") @db.Decimal(14, 2)
  netProfit        Decimal                   @default(0) @map("net_profit") @db.Decimal(14, 2)
  customerDiscount Decimal                   @default(0) @map("customer_discount") @db.Decimal(14, 2)
  commissionEarned Decimal                   @default(0) @map("commission_earned") @db.Decimal(14, 2)
  status           DigitalServiceQuoteStatus @default(PENDING)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items            DigitalServiceQuoteItem[]

  @@map("digital_service_quotes")
}

model DigitalServiceQuoteItem {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId          String                 @map("quote_id") @db.Uuid
  quote            DigitalServiceQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceId        String?                @map("service_id") @db.Uuid
  service          DigitalServiceService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name             String
  unit             String
  unitPrice        Decimal                @map("unit_price") @db.Decimal(14, 2)
  quantity         Int
  lineTotal        Decimal                @map("line_total") @db.Decimal(14, 2)
  status           String                 @default("pending")
  completedAt      DateTime?              @map("completed_at") @db.Timestamptz(6)
  carryoverDate    DateTime?              @map("carryover_date") @db.Date
  paymentChannels  String[]               @default([]) @map("payment_channels")
  cashAmount       Decimal                @default(0) @map("cash_amount") @db.Decimal(14, 2)
  transferAmount   Decimal                @default(0) @map("transfer_amount") @db.Decimal(14, 2)
  redemptionAmount Decimal                @default(0) @map("redemption_amount") @db.Decimal(14, 2)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("digital_service_quote_items")
}

model DigitalServiceDayClose {
  date         DateTime @id @db.Date
  pendingCount Int      @default(0) @map("pending_count")
  closedAt     DateTime @default(now()) @map("closed_at") @db.Timestamptz(6)

  @@map("digital_service_day_closes")
}

model DigitalServiceFinanceEntry {
  id            String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryDate     DateTime                    @map("entry_date") @db.Date
  type          DigitalServiceFinanceType
  category      String
  description   String?
  amount        Decimal                     @db.Decimal(14, 2)
  paymentMethod DigitalServicePaymentMethod @map("payment_method")
  source        String                      @default("manual")
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entryDate, type])
  @@map("digital_service_finance_entries")
}

model DigitalServiceAppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("digital_service_app_settings")
}
