NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used by the admin account seeder. Never expose or commit it.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin identity for `npm run db:seed:admin`. ADMIN_PASSWORD is only needed
# when creating a new Supabase Auth user; existing users keep their password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Supavisor transaction-pooler URL for the application runtime.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Supabase database URL for Prisma migrations.
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://uzxchfjgmqbdsvkxojbm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_okEg3aJbGvIMfu8rdtodog_mDUL-1ec